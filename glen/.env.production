NODE_ENV=production
PORT=3000
FRONTEND_URL=http://localhost:3000

# Database is not available in production container - running in static mode
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# JWT (change these in real production!)
JWT_ACCESS_SECRET=production_secret_key_change_me
JWT_REFRESH_SECRET=production_refresh_secret_change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=
